# ---------------------------------------------------------------------------
# Database (Supabase Postgres via Prisma)
# ---------------------------------------------------------------------------
# Pooled connection (used at runtime)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# Direct connection (used for migrations)
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key" # server-only, never expose to client

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
IP_HASH_SALT="change-me-in-production"

# ---------------------------------------------------------------------------
# WalletConnect
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="your-walletconnect-project-id"

# ---------------------------------------------------------------------------
# Captcha (Cloudflare Turnstile)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---------------------------------------------------------------------------
# Rate limiting (Upstash Redis) — optional; falls back to in-memory in dev
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Optional: Anthropic API for richer AI risk-summary phrasing
# (the app works fully without this — see src/lib/ai-summary.ts)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
